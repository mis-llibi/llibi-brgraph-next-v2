# Database: local MySQL from compose.yaml
DATABASE_URL=mysql://llibi:llibi-local@127.0.0.1:3307/llibi_brgraph
SHADOW_DATABASE_URL=mysql://llibi:llibi-local@127.0.0.1:3307/llibi_brgraph_shadow

# Auth: generate one strong value and use it for both variables
AUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_SECRET=replace-with-the-same-random-secret
NEXTAUTH_URL=http://localhost:4000

# Object storage: local MinIO from compose.yaml
DO_LLIBI_ACCESS_KEY_ID=llibi
DO_LLIBI_SECRET_ACCESS_KEY=llibi-local-secret
DO_LLIBI_DEFAULT_REGION=us-east-1
DO_LLIBI_ENDPOINT=http://127.0.0.1:9000
DO_LLIBI_BUCKET=llibi-local
DO_LLIBI_CDN_ENDPOINT=http://127.0.0.1:9000/llibi-local
S3_FORCE_PATH_STYLE=true
S3_USE_PUBLIC_READ_ACL=false

# Email: actual delivery uses Resend, not SMTP
RESEND_API_KEY=re_replace_with_a_valid_key
SMTP_FROM_NAME=LLIBI Local
SMTP_FROM_EMAIL=onboarding@resend.dev

# Currently diagnostic-only values logged by src/lib/email.ts
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=local
