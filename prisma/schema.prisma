// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model user{
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  admin   Boolean  @default(false)
  canUpload Boolean @default(false)
  canCreate Boolean @default(false)
  canViewDeck Boolean @default(false)
  canUploadDeck Boolean @default(false)
  canAdd Boolean @default(false)
  canRemove Boolean @default(false)
  canEdit Boolean @default(false)
  superAdmin Boolean @default(false)
  isActive Boolean @default(true)
  mustChangePassword Boolean @default(false)
  lastLogin DateTime?
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-referencing relation for tracking who created whom
  creator user? @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers user[] @relation("UserCreatedBy")

  @@map("user")
}

model insurers{
  id Int @id @default(autoincrement())
  name String @unique

  clients clients[]
  uploads uploads[]

  @@map("insurers")
}

model clients{
  id Int @id @default(autoincrement()) 
  client_name String
  description String?
  insurer_id Int?
  insurer insurers? @relation(fields: [insurer_id], references: [id])

  uploads uploads[]
  decks decks[]
  intellicareMasterlist intellicareMasterlist[]
  maxicareMasterlist maxicareMasterlist[]
  philcareMasterlist philcareMasterlist[]
  intellicare intellicare[]
  maxicare maxicare[]
  philcare philcare[]
  customIllnesses customIllnesses[]

  @@map("clients")
}

model uploads{
  id Int @id @default(autoincrement())
  clientId Int
  insurerId Int
  year String
  months String?
  type String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients clients @relation(fields: [clientId], references: [id])
  insurers insurers @relation(fields: [insurerId], references: [id])
}

model decks {
  id Int @id @default(autoincrement())
  name String
  key String
  description String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientId Int

  clients clients @relation(fields: [clientId], references: [id])

  @@map("decks")
}

model intellicareMasterlist {
  id Int @id @default(autoincrement())
  clientId Int
  PY String?
  ACCOUNT_NO String?
  STATUS String? @db.Char(1)
  MEMBER_TYPE String? @db.Char(1)
  RNB String?
  PREEXIST Float?
  LIMIT Float?
  BIRTHDATE DateTime?
  AGE Int?
  RELATION String?
  EE_ID String?
  CARD_NO String?
  COMPANY String? @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients clients @relation(fields: [clientId], references: [id])

  @@map("intellicareMasterlist")
}

model maxicareMasterlist {
  id Int @id @default(autoincrement())
  clientId Int
  PY String?
  ACCOUNT_NO String? //POLICYNO
  STATUS String? @db.Char(1) //STATUSDESC
  MEMBER_TYPE String? @db.Char(1) //MEMBERTYPE
  LIMIT Float? //MBL
  RELATION String? //REALDESC
  EE_ID String? //EMPNO
  CARD_NO String? //CARDNO
  COMPANY String? @db.VarChar(255) //COMPANY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients clients @relation(fields: [clientId], references: [id])

  @@map("maxicareMasterlist")
}

model philcareMasterlist {
  id Int @id @default(autoincrement())
  clientId Int
  PY String?
  POLICY_NO String? //Policy No
  AGREEMENT_NO String? //Agreement No
  EMPLOYEE_NO String? //Employee No
  SUB_OFFICE_CODE Int? //Sub Office Code
  SUB_OFFICE_NAME String? @db.VarChar(255) //Sub Office Name
  CERTIFICATE_NO String? //Certificate No
  LAST_NAME String? //Last Name
  FIRST_NAME String? //First Name
  MI String? //MI
  MEMBER_ORIG_EFF_DATE DateTime? //Member Orig Eff Date
  MEMBER_EFF_DATE DateTime? //Member Eff Date
  GENDER String? //Gender
  AGE Int? //Age
  DATE_OF_BIRTH DateTime? //Date Of Birth
  MARITAL_STATUS String? //Marital Status
  RELATIONSHIP String? //Relationship
  CLASS_CODE Int? //Class Code
  CLASS_DEFINITION String? //Class Definition
  ROOM_TYPE String? //Room Type
  ROOM_BOARD_MAX_AMT Float? //Room Board Max Amt
  MEMBER_FEE_PLUS_RIDER Float? //Member Fee Plus Rider
  DENTAL_CODE String? //Dental Code
  ACCIDENTAL_RIDER Float? //Accidental Rider
  ACCIDENTAL_RIDER_COVERAGE_AMT Float? //Accidental Rider Coverage Amount
  LIFE_RIDER Float? //Life Rider
  LIFE_RIDER_COVERAGE_AMT Float? //Life Rider Coverage Amount
  TRAVEL_ASSISTANCE_PROGRAM Float? //Travel Assistance Program
  TAP_COVERAGE_AMT Float? //TAP Coverage Amount
  PRE_EXISTING_CODE Int? //Pre-Existing Code
  MEMBER_STATUS String? //Member Status
  PAYOR String? //Payor
  MEMBER_COVERAGE String? //Member Coverage
  REMARKS String? //Remarks
  ACCOUNT_TYPE String? //Account Type
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients clients @relation(fields: [clientId], references: [id])

  @@map("philcareMasterlist")
}

model intellicare {
  id Int @id @default(autoincrement())
  clientId Int
  PY String
  Company String? @db.VarChar(255)
  Member_Account String?
  Member_Type String?
  ICD_10_Code String?
  Diagnosis String? @db.VarChar(255)
  Claim_Type String?
  Admission_Date  DateTime?
  Provider_Name String?
  Provider_Type String?
  Approved_Claim_Amount Float? @db.Double
  Class_Plan_Level String?
  Maximum_Benefit_Limit Float? @db.Double
  Date_of_Birth DateTime?
  Relationship String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  clients clients @relation(fields: [clientId], references: [id])

  @@map("intellicare")
}

model maxicare {
  id Int @id @default(autoincrement())
  clientId Int
  PY String
  Company String? @db.VarChar(255)
  Member_Account String? //Member_ID
  Member_Type String? //Plan
  ICD_10_Code String? //ICD10_Code
  Diagnosis String? @db.VarChar(255) //ICD10_Desc
  Claim_Type String? //Claim_Type
  Admission_Date  DateTime? //Admission_Date
  Provider_Name String? //Provider_Name
  Provider_Type String? //Provider_Type
  Approved_Claim_Amount Float? @db.Double //Approved_Claim_Amount
  Relationship String? //Relationship
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  clients clients @relation(fields: [clientId], references: [id])

  @@map("maxicare")
}

model philcare {
  id Int @id @default(autoincrement())
  clientId Int
  PY String
  Company String? @db.VarChar(255) //Company
  Member_Account String? //Claim No
  Member_Type String? //Derived from Relation or IP/OP
  ICD_10_Code String? //Not available in current format
  Diagnosis String? @db.VarChar(255) //Diagnosis
  Claim_Type String? //IP/OP
  Admission_Date DateTime? //Date From
  Provider_Name String? //Provider
  Provider_Type String? //Not available, could be derived
  Approved_Claim_Amount Float? @db.Double //Utilization
  Relationship String? //Relation
  // Philcare-specific fields
  LOS Int? //LOS (Length of Stay)
  IP_OP String? //IP/OP
  NR_R String? //NR/R (Non-Reimbursable/Reimbursable)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  clients clients @relation(fields: [clientId], references: [id])

  @@map("philcare")
}


model customIllnesses{
  id Int @id @default(autoincrement())
  clientId Int
  py String?
  member_type String?
  icd_10_code String?
  diagnosis String?
  claim_amount Int?
  percentage_to_total_amount Decimal? @db.Decimal(8,2)
  claim_count Int?
  percentage_to_total_count Decimal? @db.Decimal(8,2)
  average_cost_per_claim Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients clients @relation(fields: [clientId], references: [id])

  @@map("customIllnesses")
}


