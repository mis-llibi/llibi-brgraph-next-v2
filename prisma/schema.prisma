// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model user {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  password           String
  admin              Boolean   @default(false)
  canUpload          Boolean   @default(false)
  canCreate          Boolean   @default(false)
  canViewDeck        Boolean   @default(false)
  canUploadDeck      Boolean   @default(false)
  canAdd             Boolean   @default(false)
  canRemove          Boolean   @default(false)
  canEdit            Boolean   @default(false)
  superAdmin         Boolean   @default(false)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLogin          DateTime?
  createdBy          Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Self-referencing relation for tracking who created whom
  creator      user?  @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers user[] @relation("UserCreatedBy")

  @@map("user")
}

model insurers {
  id   Int    @id @default(autoincrement())
  name String @unique

  clients            clients[]
  uploads            uploads[]
  datasets           datasets[]
  masterlistEntries  masterlistEntries[]
  utilizationEntries utilizationEntries[]

  @@map("insurers")
}

model datasets {
  id        Int      @id @default(autoincrement())
  clientId  Int
  insurerId Int
  title     String   @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clients  clients  @relation(fields: [clientId], references: [id])
  insurers insurers @relation(fields: [insurerId], references: [id])

  // Dataset records
  masterlistEntries  masterlistEntries[]
  utilizationEntries utilizationEntries[]
  uploads            uploads[]

  @@unique([clientId, title])
  @@index([clientId])
  @@index([insurerId])
  @@index([title])
  @@map("datasets")
}

model clients {
  id          Int       @id @default(autoincrement())
  client_name String
  description String?
  insurer_id  Int?
  insurer     insurers? @relation(fields: [insurer_id], references: [id])

  uploads            uploads[]
  datasets           datasets[]
  decks              decks[]
  masterlistEntries  masterlistEntries[]
  utilizationEntries utilizationEntries[]
  customIllnesses    customIllnesses[]

  @@map("clients")
}

model uploads {
  id        Int      @id @default(autoincrement())
  clientId  Int
  insurerId Int
  datasetId Int?
  year      String
  months    String?
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients  clients   @relation(fields: [clientId], references: [id])
  insurers insurers  @relation(fields: [insurerId], references: [id])
  datasets datasets? @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("uploads")
}

model decks {
  id          Int      @id @default(autoincrement())
  name        String
  key         String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clientId    Int

  clients clients @relation(fields: [clientId], references: [id])

  @@map("decks")
}

model masterlistEntries {
  id           Int      @id @default(autoincrement())
  clientId     Int
  insurerId    Int
  datasetId    Int
  maskedId     String?  @db.VarChar(191)
  companyName  String   @db.VarChar(500)
  relationship String   @db.VarChar(191)
  memberType   String   @db.VarChar(191)
  planType     String?  @db.VarChar(191)
  mbl          Float?   @db.Double
  ageGroup     String?  @db.VarChar(191)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clients  clients  @relation(fields: [clientId], references: [id])
  insurers insurers @relation(fields: [insurerId], references: [id])
  datasets datasets @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([insurerId])
  @@index([datasetId])
  @@map("masterlistEntries")
}

model utilizationEntries {
  id                  Int       @id @default(autoincrement())
  clientId            Int
  insurerId           Int
  datasetId           Int
  maskedId            String?   @db.VarChar(191)
  companyName         String    @db.VarChar(500)
  relationship        String    @db.VarChar(191)
  memberType          String    @db.VarChar(191)
  planType            String?   @db.VarChar(191)
  mbl                 Float?    @db.Double
  ageGroup            String?   @db.VarChar(191)
  diagnosis           String    @db.VarChar(1000)
  providerName        String    @db.VarChar(500)
  claimCoverageType   String    @db.VarChar(191)
  admissionDate       DateTime?
  dischargeDate       DateTime?
  dateProcessed       DateTime?
  approvedClaimAmount Float     @db.Double
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  clients  clients  @relation(fields: [clientId], references: [id])
  insurers insurers @relation(fields: [insurerId], references: [id])
  datasets datasets @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([insurerId])
  @@index([datasetId])
  @@map("utilizationEntries")
}

model customIllnesses {
  id                         Int      @id @default(autoincrement())
  clientId                   Int
  py                         String?
  member_type                String?
  icd_10_code                String?
  diagnosis                  String?  @db.VarChar(1000)
  claim_amount               Int?
  percentage_to_total_amount Decimal? @db.Decimal(8, 2)
  claim_count                Int?
  percentage_to_total_count  Decimal? @db.Decimal(8, 2)
  average_cost_per_claim     Int?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  clients clients @relation(fields: [clientId], references: [id])

  @@map("customIllnesses")
}
